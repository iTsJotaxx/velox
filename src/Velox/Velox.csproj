<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Velox</AssemblyName>
    <RootNamespace>Velox</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Velox.ico</ApplicationIcon>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Version>1.2.0</Version>
    <Product>Velox</Product>
    <Company>Velox</Company>
    <Description>Velox - Windows performance optimizer</Description>
    <Copyright>Copyright (c) 2026 iTsJotaxx</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <StartupObject>Velox.Program</StartupObject>
  </PropertyGroup>

  <!-- App.xaml se carga desde Program.Main (para activar el DPI por monitor antes de iniciar WPF) -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Velox.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Velox.IntegrationTests" />
  </ItemGroup>

</Project>

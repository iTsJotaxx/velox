<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Tools (en) -->
  <!-- Scan steps -->
  <sys:String x:Key="scan.step.os">Reading operating system and memory...</sys:String>
  <sys:String x:Key="scan.step.cpu">Reading processor...</sys:String>
  <sys:String x:Key="scan.step.gpu">Reading graphics card and displays...</sys:String>
  <sys:String x:Key="scan.step.disk">Detecting device type and disks...</sys:String>
  <sys:String x:Key="scan.step.power">Reading power and security settings...</sys:String>
  <sys:String x:Key="scan.step.procs">Checking background programs...</sys:String>

  <!-- Startup program sources -->
  <sys:String x:Key="startup.source.user">User</sys:String>
  <sys:String x:Key="startup.source.all">All users</sys:String>
  <sys:String x:Key="startup.source.all32">All users (32-bit)</sys:String>
  <sys:String x:Key="startup.source.folderUser">Startup folder (user)</sys:String>
  <sys:String x:Key="startup.source.folderAll">Startup folder (all users)</sys:String>

  <!-- Process priorities -->
  <sys:String x:Key="prio.normal">Normal</sys:String>
  <sys:String x:Key="prio.high">High</sys:String>
  <sys:String x:Key="prio.abovenormal">Above normal</sys:String>
  <sys:String x:Key="prio.belownormal">Below normal</sys:String>
  <sys:String x:Key="prio.idle">Low</sys:String>
  <sys:String x:Key="prio.realtime">Real time</sys:String>

  <!-- Tool messages and errors -->
  <sys:String x:Key="tools.err.protectedKill">“{0}” is a system process and cannot be closed from here.</sys:String>
  <sys:String x:Key="tools.err.protectedPriority">“{0}” is a system process and its priority cannot be changed from here.</sys:String>
  <sys:String x:Key="tools.err.gamePath">The path of this process's executable cannot be read.</sys:String>
  <sys:String x:Key="tools.restore.created">Restore point created.</sys:String>
  <sys:String x:Key="tools.restore.skipped">Windows did not create a new restore point because one from the last 24 hours already exists. That one will serve as your starting point.</sys:String>
  <sys:String x:Key="tools.restore.failed">The restore point could not be created: {0}</sys:String>
  <sys:String x:Key="tools.restore.disabled">System Protection is turned off by a Windows policy.</sys:String>
  <sys:String x:Key="tools.restore.off">System Protection is turned off for the Windows drive. Turn it on to be able to create restore points.</sys:String>
  <sys:String x:Key="tools.restore.timeout">Windows took more than 4 minutes to create the restore point; Velox stopped waiting.</sys:String>
  <sys:String x:Key="tools.restore.errCode">Windows returned error {0}. Check that System Protection is turned on for the system drive.</sys:String>
  <sys:String x:Key="clean.title">Deep clean</sys:String>
  <sys:String x:Key="clean.text">Measures and deletes only caches and leftovers that Windows and programs create again: never documents, downloads or the Recycle Bin.</sys:String>
  <sys:String x:Key="clean.analyze">Analyze</sys:String>
  <sys:String x:Key="clean.reanalyze">Analyze again</sys:String>
  <sys:String x:Key="clean.cleanN">Clean ({0})</sys:String>
  <sys:String x:Key="clean.busyAnalyze">Measuring caches and leftovers...</sys:String>
  <sys:String x:Key="clean.busyOne">Cleaning: {0}</sys:String>
  <sys:String x:Key="clean.done">Clean-up finished: {0} freed.</sys:String>
  <sys:String x:Key="clean.skippedApps">Open browsers are skipped ({0}): close them to include them.</sys:String>
  <sys:String x:Key="clean.block.reboot">Windows has an update half installed: restart before cleaning this.</sys:String>
  <sys:String x:Key="clean.temp">Temporary files</sys:String>
  <sys:String x:Key="clean.temp.desc">Yours and Windows', older than 24 hours.</sys:String>
  <sys:String x:Key="clean.wu">Windows Update downloads</sys:String>
  <sys:String x:Key="clean.wu.desc">Installers of updates already applied.</sys:String>
  <sys:String x:Key="clean.do">Delivery Optimization</sys:String>
  <sys:String x:Key="clean.do.desc">Copies of updates kept to share with other PCs.</sys:String>
  <sys:String x:Key="clean.browsers">Browser caches</sys:String>
  <sys:String x:Key="clean.browsers.desc">Chrome, Edge, Brave, Opera, Vivaldi and Firefox (passwords, history and sessions are not touched).</sys:String>
  <sys:String x:Key="clean.shaders">Shader caches</sys:String>
  <sys:String x:Key="clean.shaders.desc">DirectX, NVIDIA and AMD. Games rebuild them (the first minutes may run a bit worse).</sys:String>
  <sys:String x:Key="clean.thumbs">File Explorer thumbnails</sys:String>
  <sys:String x:Key="clean.thumbs.desc">Rebuilt when each folder is opened (a bit slower at first).</sys:String>
  <sys:String x:Key="clean.reports">Error reports and dumps</sys:String>
  <sys:String x:Key="clean.reports.desc">Windows crash reports and memory dumps from unexpected shutdowns.</sys:String>
  <sys:String x:Key="dns.title">DNS</sys:String>
  <sys:String x:Key="dns.text">The server that translates the name of every website and game. Measure which one answers fastest from your connection and switch in one click. Only IPv4 changes, and you can go back to the original.</sys:String>
  <sys:String x:Key="dns.now">Now: {0}</sys:String>
  <sys:String x:Key="dns.custom">Custom</sys:String>
  <sys:String x:Key="dns.measure">Measure</sys:String>
  <sys:String x:Key="dns.restore">Back to the original</sys:String>
  <sys:String x:Key="dns.busyMeasure">Measuring DNS servers...</sys:String>
  <sys:String x:Key="dns.busySet">Changing DNS...</sys:String>
  <sys:String x:Key="dns.yours">Your current DNS  {0}</sys:String>
  <sys:String x:Key="dns.noReply">no reply</sys:String>
  <sys:String x:Key="dns.use">Use</sys:String>
  <sys:String x:Key="dns.inUse">In use</sys:String>
  <sys:String x:Key="dns.confirmTitle">Use {0} DNS?</sys:String>
  <sys:String x:Key="dns.confirmText">It is set on every connected adapter ({0} and {1}). Velox keeps the DNS you had and you can get it back with “Back to the original” or from History.</sys:String>
  <sys:String x:Key="dns.set">DNS changed to {0}.</sys:String>
</ResourceDictionary>

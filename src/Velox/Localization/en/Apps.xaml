  <sys:String x:Key="unin.leftTitle">Leftovers found</sys:String>
  <sys:String x:Key="unin.leftText">These folders of the uninstalled programs are still on disk ({0}). Send them to the Recycle Bin?</sys:String>
  <sys:String x:Key="unin.leftKeep">Keep them</sys:String>
  <sys:String x:Key="unin.leftDone">{0} folders sent to the Recycle Bin ({1}).</sys:String>
  <sys:String x:Key="unin.err.store">Windows did not allow removing this app</sys:String>
  <sys:String x:Key="unin.err.timeout">the uninstaller did not finish in 30 minutes</sys:String>

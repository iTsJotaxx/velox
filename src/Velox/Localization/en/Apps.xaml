  <sys:String x:Key="ui.nav.uninstall">Uninstall apps</sys:String>
  <sys:String x:Key="unin.title">Uninstall apps</sys:String>
  <sys:String x:Key="unin.subtitle">Simpler than the Windows one: search, tick and uninstall. Programs that allow it are removed silently; the rest open their own uninstaller. At the end, Velox looks for folders left behind.</sys:String>
  <sys:String x:Key="unin.filter">Search program</sys:String>
  <sys:String x:Key="unin.kind.desktop">Programs</sys:String>
  <sys:String x:Key="unin.kind.store">Microsoft Store</sys:String>
  <sys:String x:Key="unin.sort.name">Name</sys:String>
  <sys:String x:Key="unin.sort.size">Size</sys:String>
  <sys:String x:Key="unin.sort.date">Date</sys:String>
  <sys:String x:Key="unin.loading">Reading installed programs...</sys:String>
  <sys:String x:Key="unin.none">Nothing matches.</sys:String>
  <sys:String x:Key="unin.total">{0} programs</sys:String>
  <sys:String x:Key="unin.totalSize">{0} programs  ·  {1}</sys:String>
  <sys:String x:Key="unin.uninstallNone">Uninstall</sys:String>
  <sys:String x:Key="unin.uninstallN">Uninstall ({0})</sys:String>
  <sys:String x:Key="unin.badge.quiet">Silent</sys:String>
  <sys:String x:Key="unin.badge.quietTip">Uninstalls by itself, with no windows.</sys:String>
  <sys:String x:Key="unin.badge.protected">Protected</sys:String>
  <sys:String x:Key="protect.prog.runtime">Protected: other programs or games need this component (Visual C++, .NET, DirectX...). If removed, they may stop opening.</sys:String>
  <sys:String x:Key="protect.prog.driver">Protected: it is a driver or the software of a hardware component. Update it or roll it back from «Drivers».</sys:String>
  <sys:String x:Key="protect.prog.store">Protected: it is an essential part of Windows (Microsoft Store, App Installer, Windows Security...).</sys:String>
  <sys:String x:Key="protect.prog.system">Protected: it is part of Windows.</sys:String>
  <sys:String x:Key="protect.prog.velox">Protected: it is Velox itself.</sys:String>
  <sys:String x:Key="protect.path.invalid">Invalid path.</sys:String>
  <sys:String x:Key="protect.path.drive">Protected: it is the root of a drive.</sys:String>
  <sys:String x:Key="protect.path.system">Protected: it is a Windows folder or file. Deleting it could stop the PC from starting.</sys:String>
  <sys:String x:Key="protect.path.profile">Protected: it is a Windows user&apos;s folder.</sys:String>
  <sys:String x:Key="protect.path.key">Protected: it is a key Windows or user folder (Documents, Downloads, AppData, Program Files...). You can delete what is inside, but not the folder.</sys:String>
  <sys:String x:Key="protect.path.contains">Protected: it contains key Windows or user folders.</sys:String>
  <sys:String x:Key="protect.path.velox">Protected: it is Velox&apos;s data (backups used to undo changes).</sys:String>
  <sys:String x:Key="protect.path.installed">Protected: it is the folder of an installed program. Uninstall it from «Uninstall apps» so no broken leftovers remain.</sys:String>
  <sys:String x:Key="unin.line.interactive">will open its uninstaller</sys:String>
  <sys:String x:Key="unin.confirmTitle">Uninstall {0} programs?</sys:String>
  <sys:String x:Key="unin.confirmText">They are removed one after another. The ones that cannot be removed silently open their own uninstaller: follow it to the end.</sys:String>
  <sys:String x:Key="unin.confirmOk">Uninstall</sys:String>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Memory (en) -->
  <sys:String x:Key="ui.nav.memory">Memory (RAM)</sys:String>
  <sys:String x:Key="mem.title">Memory (RAM)</sys:String>
  <sys:String x:Key="mem.subtitle">Free up RAM without closing anything: Windows keeps caches and unused pages in memory. Velox releases them so there is free RAM for your games and programs.</sys:String>
  <sys:String x:Key="mem.inUse">in use</sys:String>
  <sys:String x:Key="mem.headline">{0} available of {1}</sys:String>
  <sys:String x:Key="mem.subline">{0} completely free and {1} in cache (standby), which can be freed instantly.</sys:String>
  <sys:String x:Key="mem.noLists">Without administrator rights the memory list details cannot be read.</sys:String>
  <sys:String x:Key="mem.legend.use">In use</sys:String>
  <sys:String x:Key="mem.legend.useTip">Memory programs and Windows are using right now.</sys:String>
  <sys:String x:Key="mem.legend.mod">Modified</sys:String>
  <sys:String x:Key="mem.legend.modTip">Data that must be written to disk before that memory can be reused.</sys:String>
  <sys:String x:Key="mem.legend.stb">Standby</sys:String>
  <sys:String x:Key="mem.legend.stbTip">Windows cache: recently used files and programs. It counts as available, but Windows is sometimes slow to release it.</sys:String>
  <sys:String x:Key="mem.legend.free">Free</sys:String>
  <sys:String x:Key="mem.legend.freeTip">Empty memory, ready to use instantly.</sys:String>
  <sys:String x:Key="mem.cleanNow">Free up RAM now</sys:String>
  <sys:String x:Key="mem.lastNone">No program gets closed.</sys:String>
  <sys:String x:Key="mem.last">Last clean at {0}: +{1} free ({2} free afterwards).</sys:String>
  <sys:String x:Key="mem.noneSelected">Turn on at least one option in «What gets cleaned».</sys:String>
  <sys:String x:Key="mem.done">RAM freed: +{0}. {1} free now.</sys:String>
  <sys:String x:Key="mem.donePartial">RAM freed: +{0} (with warnings)</sys:String>
  <sys:String x:Key="mem.partialText">Some steps could not be done. The rest was freed anyway.</sys:String>

  <sys:String x:Key="mem.optsTitle">What gets cleaned</sys:String>
  <sys:String x:Key="mem.optsText">Used when you press «Free up RAM now» (and in Tools).</sys:String>
  <sys:String x:Key="mem.opt.ws">Memory of open programs</sys:String>
  <sys:String x:Key="mem.opt.wsText">Programs release the memory they are not using (they are not closed). This frees the most RAM; switching back to a program may take a moment while it gets it back.</sys:String>
  <sys:String x:Key="mem.opt.standby">Standby cache</sys:String>
  <sys:String x:Key="mem.opt.standbyText">Empties the Windows cache. The classic fix for stutters in games with little RAM.</sys:String>
  <sys:String x:Key="mem.opt.modified">Modified memory</sys:String>
  <sys:String x:Key="mem.opt.modifiedText">Writes pending data to disk so that memory can be freed too.</sys:String>
  <sys:String x:Key="mem.opt.cache">System file cache</sys:String>
  <sys:String x:Key="mem.opt.cacheText">Reduces the memory Windows uses to keep recently read files.</sys:String>
  <sys:String x:Key="mem.opt.combine">Combine duplicate memory</sys:String>
  <sys:String x:Key="mem.opt.combineText">Merges identical memory pages into one (Windows 10 and 11).</sys:String>

  <sys:String x:Key="mem.autoTitle">Automatic cleaning</sys:String>
  <sys:String x:Key="mem.autoText">While Velox is open, it empties the standby cache when free RAM drops below the limit and the cache holds at least 1 GB or 10 % of the RAM (at most once a minute). It does not touch program memory.</sys:String>
  <sys:String x:Key="mem.autoOff">Off.</sys:String>
  <sys:String x:Key="mem.autoOn">On: it will act when less than {0} % of RAM is free.</sys:String>
  <sys:String x:Key="mem.autoLast">On (limit {0} %). Last automatic clean at {1}: +{2} free.</sys:String>

  <sys:String x:Key="mem.topTitle">What uses the most RAM</sys:String>
  <sys:String x:Key="mem.topText">«Trim» makes that program release the memory it is not using, without closing it.</sys:String>
  <sys:String x:Key="mem.trim">Trim</sys:String>
  <sys:String x:Key="mem.trimTip">Frees the memory this program is not using (it is not closed)</sys:String>
  <sys:String x:Key="mem.trimmed">{0} released {1}.</sys:String>

  <sys:String x:Key="mem.step.workingSets">Program memory</sys:String>
  <sys:String x:Key="mem.step.modified">Modified memory</sys:String>
  <sys:String x:Key="mem.step.fileCache">File cache</sys:String>
  <sys:String x:Key="mem.step.standby">Standby cache</sys:String>
  <sys:String x:Key="mem.step.combine">Combine memory</sys:String>
  <sys:String x:Key="mem.err.allFailed">Windows did not allow freeing memory (was Velox opened without administrator rights?):
{0}</sys:String>
  <sys:String x:Key="mem.err.trim">Could not trim the memory of {0} (it is a protected system process).</sys:String>
</ResourceDictionary>

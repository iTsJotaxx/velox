<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Tools (es) -->
  <!-- Pasos del escaneo -->
  <sys:String x:Key="scan.step.os">Leyendo sistema operativo y memoria...</sys:String>
  <sys:String x:Key="scan.step.cpu">Leyendo procesador...</sys:String>
  <sys:String x:Key="scan.step.gpu">Leyendo tarjeta gráfica y pantallas...</sys:String>
  <sys:String x:Key="scan.step.disk">Detectando tipo de equipo y discos...</sys:String>
  <sys:String x:Key="scan.step.power">Leyendo energía y seguridad...</sys:String>
  <sys:String x:Key="scan.step.procs">Revisando programas en segundo plano...</sys:String>

  <!-- Origen de los programas de inicio -->
  <sys:String x:Key="startup.source.user">Usuario</sys:String>
  <sys:String x:Key="startup.source.all">Todos los usuarios</sys:String>
  <sys:String x:Key="startup.source.all32">Todos los usuarios (32 bits)</sys:String>
  <sys:String x:Key="startup.source.folderUser">Carpeta Inicio (usuario)</sys:String>
  <sys:String x:Key="startup.source.folderAll">Carpeta Inicio (todos)</sys:String>

  <!-- Prioridades de proceso -->
  <sys:String x:Key="prio.normal">Normal</sys:String>
  <sys:String x:Key="prio.high">Alta</sys:String>
  <sys:String x:Key="prio.abovenormal">Superior a normal</sys:String>
  <sys:String x:Key="prio.belownormal">Inferior a normal</sys:String>
  <sys:String x:Key="prio.idle">Baja</sys:String>
  <sys:String x:Key="prio.realtime">Tiempo real</sys:String>

  <!-- Mensajes y errores de las herramientas -->
  <sys:String x:Key="tools.err.protectedKill">«{0}» es un proceso del sistema y no se puede cerrar desde aquí.</sys:String>
  <sys:String x:Key="tools.err.protectedPriority">«{0}» es un proceso del sistema y no se puede cambiar su prioridad desde aquí.</sys:String>
  <sys:String x:Key="tools.err.gamePath">No se puede leer la ruta del ejecutable de este proceso.</sys:String>
  <sys:String x:Key="tools.restore.created">Punto de restauración creado.</sys:String>
  <sys:String x:Key="tools.restore.skipped">Windows no ha creado un punto nuevo porque ya existe uno de las últimas 24 horas. Ese servirá como punto de partida.</sys:String>
  <sys:String x:Key="tools.restore.failed">No se pudo crear el punto de restauración: {0}</sys:String>
  <sys:String x:Key="tools.restore.disabled">La Protección del sistema está desactivada por una directiva de Windows.</sys:String>
  <sys:String x:Key="tools.restore.off">La Protección del sistema está desactivada en la unidad de Windows. Actívala para poder crear puntos de restauración.</sys:String>
  <sys:String x:Key="tools.restore.timeout">Windows tardó más de 4 minutos en crear el punto de restauración; se ha dejado de esperar.</sys:String>
  <sys:String x:Key="tools.restore.errCode">Windows devolvió el error {0}. Comprueba que la Protección del sistema esté activada para la unidad del sistema.</sys:String>
  <sys:String x:Key="clean.title">Limpieza profunda</sys:String>
  <sys:String x:Key="clean.text">Mide y borra solo cachés y restos que Windows y los programas vuelven a crear: nunca documentos, descargas ni la papelera.</sys:String>
  <sys:String x:Key="clean.analyze">Analizar</sys:String>
  <sys:String x:Key="clean.reanalyze">Volver a analizar</sys:String>
  <sys:String x:Key="clean.cleanN">Limpiar ({0})</sys:String>
  <sys:String x:Key="clean.busyAnalyze">Midiendo cachés y restos...</sys:String>
  <sys:String x:Key="clean.busyOne">Limpiando: {0}</sys:String>
  <sys:String x:Key="clean.done">Limpieza terminada: {0} liberados.</sys:String>
  <sys:String x:Key="clean.skippedApps">Se omite lo de los navegadores abiertos ({0}): ciérralos para incluirlos.</sys:String>
  <sys:String x:Key="clean.block.reboot">Windows tiene una actualización a medio instalar: reinicia antes de limpiar esto.</sys:String>
  <sys:String x:Key="clean.temp">Archivos temporales</sys:String>
  <sys:String x:Key="clean.temp.desc">De tu usuario y de Windows, con más de 24 horas.</sys:String>
  <sys:String x:Key="clean.wu">Descargas de Windows Update</sys:String>
  <sys:String x:Key="clean.wu.desc">Instaladores de actualizaciones ya aplicadas.</sys:String>
  <sys:String x:Key="clean.do">Optimización de distribución</sys:String>
  <sys:String x:Key="clean.do.desc">Copias de actualizaciones para compartir con otros equipos.</sys:String>
  <sys:String x:Key="clean.browsers">Caché de los navegadores</sys:String>
  <sys:String x:Key="clean.browsers.desc">Chrome, Edge, Brave, Opera, Vivaldi y Firefox (no toca contraseñas, historial ni sesiones).</sys:String>
  <sys:String x:Key="clean.shaders">Caché de sombreadores</sys:String>
  <sys:String x:Key="clean.shaders.desc">DirectX, NVIDIA y AMD. Los juegos la regeneran (los primeros minutos pueden ir algo peor).</sys:String>
  <sys:String x:Key="clean.thumbs">Miniaturas del Explorador</sys:String>
  <sys:String x:Key="clean.thumbs.desc">Se vuelven a crear al abrir cada carpeta (al principio irá algo más lento).</sys:String>
  <sys:String x:Key="clean.reports">Informes de errores y volcados</sys:String>
  <sys:String x:Key="clean.reports.desc">Informes de fallos de Windows y volcados de memoria de cierres inesperados.</sys:String>
  <sys:String x:Key="dns.title">DNS</sys:String>
  <sys:String x:Key="dns.text">El servidor que traduce el nombre de cada web y juego. Mide cuál responde antes desde tu conexión y cámbialo con un clic. Solo cambia IPv4 y se puede volver al original.</sys:String>
  <sys:String x:Key="dns.now">Ahora: {0}</sys:String>
  <sys:String x:Key="dns.custom">Personalizado</sys:String>
  <sys:String x:Key="dns.measure">Medir</sys:String>
  <sys:String x:Key="dns.restore">Volver al original</sys:String>
  <sys:String x:Key="dns.busyMeasure">Midiendo los servidores DNS...</sys:String>
  <sys:String x:Key="dns.busySet">Cambiando el DNS...</sys:String>
  <sys:String x:Key="dns.yours">Tu DNS actual  {0}</sys:String>
  <sys:String x:Key="dns.noReply">sin respuesta</sys:String>
  <sys:String x:Key="dns.use">Usar</sys:String>
  <sys:String x:Key="dns.inUse">En uso</sys:String>
  <sys:String x:Key="dns.confirmTitle">¿Usar el DNS de {0}?</sys:String>
  <sys:String x:Key="dns.confirmText">Se pone en todos los adaptadores conectados ({0} y {1}). Velox guarda el DNS que tenías y lo puedes recuperar con «Volver al original» o desde el Historial.</sys:String>
  <sys:String x:Key="dns.set">DNS cambiado a {0}.</sys:String>
</ResourceDictionary>

  <sys:String x:Key="apps.confirmText">Se instalan una detrás de otra, en silencio. Algunas pueden abrirse solas al terminar. Puedes seguir usando el equipo.</sys:String>
  <sys:String x:Key="apps.confirmOk">Empezar</sys:String>

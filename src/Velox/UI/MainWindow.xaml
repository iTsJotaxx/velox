<Window x:Class="Velox.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velox" Width="1280" Height="820" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource FontText}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/Velox.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border x:Name="RootBorder" Background="{StaticResource Bg}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===================================================== Barra lateral -->
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,16,0,20">
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentGradient}">
              <Canvas Width="36" Height="36">
                <Line X1="4.5" Y1="14.5" X2="9.5" Y2="14.5" Stroke="#99FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line X1="6" Y1="18.7" X2="11" Y2="18.7" Stroke="#99FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Fill="White" Data="M7.2,8.6 L13.7,8.6 L18.7,21.6 L23.8,8.6 L29.5,8.6 L21.6,28.1 L15.8,28.1 Z"/>
              </Canvas>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Velox" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtVersion" Style="{StaticResource Caption}" Text="v1.0.0"/>
            </StackPanel>
          </StackPanel>

          <!-- Monitor en vivo -->
          <Border DockPanel.Dock="Bottom" Margin="14,0,14,14" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Padding="14,12,14,8">
            <StackPanel>
              <TextBlock Text="{DynamicResource ui.monitor.title}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <Grid Margin="0,0,0,8">
                <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="TxtCpu" Text="--" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
              </Grid>
              <ProgressBar x:Name="BarCpu" Height="4" Margin="0,-4,0,10"/>
              <Grid Margin="0,0,0,8">
                <TextBlock Text="RAM" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="TxtRam" Text="--" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
              </Grid>
              <ProgressBar x:Name="BarRam" Height="4" Margin="0,-4,0,10" Foreground="{StaticResource Success}"/>
              <Grid Margin="0,0,0,8">
                <TextBlock Text="GPU" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="TxtGpu" Text="--" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
              </Grid>
              <ProgressBar x:Name="BarGpu" Height="4" Margin="0,-4,0,10" Foreground="{StaticResource Violet}"/>
              <Grid Margin="0,0,0,8">
                <TextBlock Text="VRAM" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="TxtVram" Text="--" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
              </Grid>
              <ProgressBar x:Name="BarVram" Height="4" Margin="0,-4,0,8" Foreground="{StaticResource Warning}"/>
            </StackPanel>
          </Border>

          <StackPanel>
            <TextBlock Text="{DynamicResource ui.nav.section}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="26,0,0,8"/>
            <RadioButton x:Name="NavSummary" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="{DynamicResource ui.nav.summary}" Click="Nav_Click" CommandParameter="summary"/>
            <RadioButton x:Name="NavOptimizations" Style="{StaticResource NavItem}" Tag="&#xE945;" Content="{DynamicResource ui.nav.optimizations}" Click="Nav_Click" CommandParameter="optimizations"/>
            <RadioButton x:Name="NavStartup" Style="{StaticResource NavItem}" Tag="&#xE7E8;" Content="{DynamicResource ui.nav.startup}" Click="Nav_Click" CommandParameter="startup"/>
            <RadioButton x:Name="NavProcesses" Style="{StaticResource NavItem}" Tag="&#xE7FC;" Content="{DynamicResource ui.nav.processes}" Click="Nav_Click" CommandParameter="processes"/>
            <RadioButton x:Name="NavDrivers" Style="{StaticResource NavItem}" Tag="&#xE772;" Content="{DynamicResource ui.nav.drivers}" Click="Nav_Click" CommandParameter="drivers"/>
            <RadioButton x:Name="NavDiagnostics" Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="{DynamicResource ui.nav.diagnostics}" Click="Nav_Click" CommandParameter="diagnostics"/>
            <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="{DynamicResource ui.nav.tools}" Click="Nav_Click" CommandParameter="tools"/>
            <TextBlock Text="{DynamicResource ui.nav.section2}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="26,16,0,8"/>
            <RadioButton x:Name="NavLog" Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="{DynamicResource ui.nav.log}" Click="Nav_Click" CommandParameter="log"/>
            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="{DynamicResource ui.nav.settings}" Click="Nav_Click" CommandParameter="settings"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ===================================================== Contenido -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de título integrada -->
        <Grid>
          <StackPanel x:Name="BusyPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0" Visibility="Collapsed">
            <TextBlock x:Name="BusySpinner" Text="&#xE895;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource AccentText}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform><RotateTransform x:Name="SpinnerRot"/></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="TxtBusy" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
            <Border x:Name="RestartChip" Background="{StaticResource WarningSoft}" CornerRadius="8" Padding="11,5" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Warning}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtRestart" Foreground="{StaticResource Warning}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click"/>
            <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click"/>
            <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" Click="Close_Click"/>
          </StackPanel>
        </Grid>

        <!-- Línea de actividad -->
        <Canvas x:Name="BusyTrack" Grid.Row="1" Height="2" VerticalAlignment="Top" ClipToBounds="True" Visibility="Collapsed" Panel.ZIndex="5">
          <Border x:Name="BusyBar" Width="220" Height="2" Background="{StaticResource AccentGradient}" CornerRadius="1">
            <Border.RenderTransform><TranslateTransform x:Name="BusyBarX" X="-220"/></Border.RenderTransform>
          </Border>
        </Canvas>

        <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False">
          <ContentControl.RenderTransform><TranslateTransform x:Name="PageShift"/></ContentControl.RenderTransform>
        </ContentControl>

        <!-- Avisos -->
        <StackPanel x:Name="ToastHost" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,26,26" Panel.ZIndex="10"/>
      </Grid>

      <!-- ===================================================== Diálogo -->
      <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Background="#B8060810" Visibility="Collapsed" Panel.ZIndex="20">
        <Border x:Name="DialogCard" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="26,24">
          <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="Black"/></Border.Effect>
          <StackPanel>
            <TextBlock x:Name="DlgTitle" Style="{StaticResource H2}" FontSize="18" TextWrapping="Wrap"/>
            <TextBlock x:Name="DlgMessage" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
            <Border x:Name="DlgDetailsBox" Background="{StaticResource CardInner}" CornerRadius="10" Margin="0,16,0,0" Padding="14,12">
              <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DlgDetails" Foreground="{StaticResource Text}" TextWrapping="Wrap" LineHeight="21"/>
              </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
              <Button x:Name="DlgCancel" Style="{StaticResource BtnBase}" Margin="0,0,10,0" Click="DlgCancel_Click"/>
              <Button x:Name="DlgOk" Style="{StaticResource BtnPrimary}" Click="DlgOk_Click" IsDefault="True"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>

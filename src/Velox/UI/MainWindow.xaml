<Window x:Class="Velox.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velox" Width="1280" Height="820" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource FontText}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/Velox.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border x:Name="RootBorder" Background="{StaticResource Bg}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===================================================== Barra lateral -->
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,16,0,14">
            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Paper}">
              <Canvas Width="36" Height="36">
                <Line X1="4.5" Y1="14.5" X2="9.5" Y2="14.5" Stroke="{StaticResource Action}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line X1="6" Y1="18.7" X2="11" Y2="18.7" Stroke="{StaticResource Action}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Fill="{StaticResource Ink}" Data="M7.2,8.6 L13.7,8.6 L18.7,21.6 L23.8,8.6 L29.5,8.6 L21.6,28.1 L15.8,28.1 Z"/>
              </Canvas>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Velox" FontFamily="{StaticResource FontDisplay}" FontStretch="SemiCondensed" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtVersion" Style="{StaticResource Caption}" Text="v1.0.0"/>
            </StackPanel>
          </StackPanel>

          <!-- Monitor en vivo (compacto, 2 x 2) -->
          <Border DockPanel.Dock="Bottom" Margin="14,6,14,12" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="12,10,12,6">
            <StackPanel>
              <TextBlock Text="{DynamicResource ui.monitor.title}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
              <UniformGrid Columns="2">
                <StackPanel Margin="0,0,7,6">
                  <Grid>
                    <TextBlock Text="CPU" Style="{StaticResource Label}" FontWeight="Normal"/>
                    <TextBlock x:Name="TxtCpu" Text="--" HorizontalAlignment="Right" FontSize="12.5" Style="{StaticResource Figure}"/>
                  </Grid>
                  <ProgressBar x:Name="BarCpu" Height="4" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="7,0,0,6">
                  <Grid>
                    <TextBlock Text="GPU" Style="{StaticResource Label}" FontWeight="Normal"/>
                    <TextBlock x:Name="TxtGpu" Text="--" HorizontalAlignment="Right" FontSize="12.5" Style="{StaticResource Figure}"/>
                  </Grid>
                  <ProgressBar x:Name="BarGpu" Height="4" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,7,6">
                  <Grid>
                    <TextBlock Text="RAM" Style="{StaticResource Label}" FontWeight="Normal"/>
                    <TextBlock x:Name="TxtRam" Text="--" HorizontalAlignment="Right" FontSize="12.5" Style="{StaticResource Figure}"/>
                  </Grid>
                  <ProgressBar x:Name="BarRam" Height="4" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="7,0,0,6">
                  <Grid>
                    <TextBlock Text="VRAM" Style="{StaticResource Label}" FontWeight="Normal"/>
                    <TextBlock x:Name="TxtVram" Text="--" HorizontalAlignment="Right" FontSize="12.5" Style="{StaticResource Figure}"/>
                  </Grid>
                  <ProgressBar x:Name="BarVram" Height="4" Margin="0,4,0,0"/>
                </StackPanel>
              </UniformGrid>
            </StackPanel>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
              <RadioButton x:Name="NavSummary" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="{DynamicResource ui.nav.summary}" Click="Nav_Click" CommandParameter="summary"/>
              <TextBlock Text="{DynamicResource ui.nav.sectionPerf}" Style="{StaticResource Label}" Margin="26,10,0,4"/>
              <RadioButton x:Name="NavOptimizations" Style="{StaticResource NavItem}" Tag="&#xE945;" Content="{DynamicResource ui.nav.optimizations}" Click="Nav_Click" CommandParameter="optimizations"/>
              <RadioButton x:Name="NavProcesses" Style="{StaticResource NavItem}" Tag="&#xE7FC;" Content="{DynamicResource ui.nav.processes}" Click="Nav_Click" CommandParameter="processes"/>
              <RadioButton x:Name="NavMemory" Style="{StaticResource NavItem}" Tag="&#xEEA0;" Content="{DynamicResource ui.nav.memory}" Click="Nav_Click" CommandParameter="memory"/>
              <RadioButton x:Name="NavStartup" Style="{StaticResource NavItem}" Tag="&#xE7E8;" Content="{DynamicResource ui.nav.startup}" Click="Nav_Click" CommandParameter="startup"/>
              <TextBlock Text="{DynamicResource ui.nav.sectionApps}" Style="{StaticResource Label}" Margin="26,10,0,4"/>
              <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" Tag="&#xE896;" Content="{DynamicResource ui.nav.apps}" Click="Nav_Click" CommandParameter="apps"/>
              <RadioButton x:Name="NavUninstall" Style="{StaticResource NavItem}" Tag="&#xE74D;" Content="{DynamicResource ui.nav.uninstall}" Click="Nav_Click" CommandParameter="uninstall"/>
              <TextBlock Text="{DynamicResource ui.nav.sectionSystem}" Style="{StaticResource Label}" Margin="26,10,0,4"/>
              <RadioButton x:Name="NavDrivers" Style="{StaticResource NavItem}" Tag="&#xE772;" Content="{DynamicResource ui.nav.drivers}" Click="Nav_Click" CommandParameter="drivers"/>
              <RadioButton x:Name="NavDisk" Style="{StaticResource NavItem}" Tag="&#xEDA2;" Content="{DynamicResource ui.nav.disk}" Click="Nav_Click" CommandParameter="disk"/>
              <RadioButton x:Name="NavTweaks" Style="{StaticResource NavItem}" Tag="&#xE771;" Content="{DynamicResource ui.nav.tweaks}" Click="Nav_Click" CommandParameter="tweaks"/>
              <RadioButton x:Name="NavDiagnostics" Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="{DynamicResource ui.nav.diagnostics}" Click="Nav_Click" CommandParameter="diagnostics"/>
              <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="{DynamicResource ui.nav.tools}" Click="Nav_Click" CommandParameter="tools"/>
              <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="{DynamicResource ui.nav.settings}" Click="Nav_Click" CommandParameter="settings"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ===================================================== Contenido -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de título integrada -->
        <Grid>
          <StackPanel x:Name="BusyPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0" Visibility="Collapsed">
            <TextBlock x:Name="BusySpinner" Text="&#xE895;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource AccentText}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform><RotateTransform x:Name="SpinnerRot"/></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="TxtBusy" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
            <Border x:Name="RestartChip" Background="{StaticResource WarningSoft}" CornerRadius="8" Padding="11,5" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Warning}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtRestart" Foreground="{StaticResource Warning}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" AutomationProperties.Name="{DynamicResource ui.a11y.minimize}"/>
            <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" AutomationProperties.Name="{DynamicResource ui.a11y.maximize}"/>
            <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="{DynamicResource ui.a11y.close}"/>
          </StackPanel>
        </Grid>

        <!-- Línea de actividad -->
        <Canvas x:Name="BusyTrack" Grid.Row="1" Height="2" VerticalAlignment="Top" ClipToBounds="True" Visibility="Collapsed" Panel.ZIndex="5">
          <Border x:Name="BusyBar" Width="220" Height="2" Background="{StaticResource Action}" CornerRadius="1">
            <Border.RenderTransform><TranslateTransform x:Name="BusyBarX" X="-220"/></Border.RenderTransform>
          </Border>
        </Canvas>

        <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False">
          <ContentControl.RenderTransform><TranslateTransform x:Name="PageShift"/></ContentControl.RenderTransform>
        </ContentControl>

        <!-- Avisos -->
        <StackPanel x:Name="ToastHost" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,26,26" Panel.ZIndex="10"/>
      </Grid>

      <!-- ===================================================== Diálogo -->
      <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Background="{StaticResource Overlay}" Visibility="Collapsed" Panel.ZIndex="20">
        <Border x:Name="DialogCard" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="26,24">
          <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.5" Color="Black"/></Border.Effect>
          <StackPanel>
            <TextBlock x:Name="DlgTitle" Style="{StaticResource H2}" FontSize="18" TextWrapping="Wrap"/>
            <TextBlock x:Name="DlgMessage" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
            <Border x:Name="DlgDetailsBox" Background="{StaticResource CardInner}" CornerRadius="10" Margin="0,16,0,0" Padding="14,12">
              <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DlgDetails" Foreground="{StaticResource Text}" TextWrapping="Wrap" LineHeight="21"/>
              </ScrollViewer>
            </Border>
            <ContentControl x:Name="DlgCustom" Margin="0,16,0,0" Visibility="Collapsed" Focusable="False"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
              <Button x:Name="DlgCancel" Style="{StaticResource BtnBase}" Margin="0,0,10,0" Click="DlgCancel_Click"/>
              <Button x:Name="DlgOk" Style="{StaticResource BtnPrimary}" Click="DlgOk_Click" IsDefault="True"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>

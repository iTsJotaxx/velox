<UserControl x:Class="Velox.UI.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="32,4,32,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid>
      <StackPanel>
        <TextBlock Text="{DynamicResource ui.startup.title}" Style="{StaticResource H1}"/>
        <TextBlock x:Name="TxtSummary" Style="{StaticResource Muted}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"/>
      </StackPanel>
      <Button Style="{StaticResource BtnBase}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Refresh_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{DynamicResource ui.btn.refresh}"/>
        </StackPanel>
      </Button>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,4" Margin="0,22,0,0">
      <ListView x:Name="List">
        <ListView.View>
          <GridView>
            <GridViewColumn Width="78">
              <GridViewColumn.Header><TextBlock Text="{DynamicResource ui.startup.colActive}"/></GridViewColumn.Header>
              <GridViewColumn.CellTemplate>
                <DataTemplate><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" Margin="6,0,0,0" Click="Toggle_Click"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="320">
              <GridViewColumn.Header><TextBlock Text="{DynamicResource ui.startup.colName}"/></GridViewColumn.Header>
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ValueName}"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="170">
              <GridViewColumn.Header><TextBlock Text="{DynamicResource ui.startup.colSource}"/></GridViewColumn.Header>
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Source}" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="420">
              <GridViewColumn.Header><TextBlock Text="{DynamicResource ui.startup.colCommand}"/></GridViewColumn.Header>
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Command}" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>
  </Grid>
</UserControl>

<UserControl x:Class="Velox.UI.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <DataTemplate x:Key="TweakRow">
      <Border x:Name="Row" Padding="14,12" CornerRadius="10" Background="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                    VerticalAlignment="Top" Margin="0,1,16,0" Click="Toggle_Click"/>
          <StackPanel Grid.Column="1">
            <WrapPanel>
              <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,2"/>
              <Border Style="{StaticResource Badge}" Background="{StaticResource SuccessSoft}" Visibility="{Binding IsOn, Converter={StaticResource BoolVis}}">
                <TextBlock Style="{StaticResource BadgeText}" Foreground="#5EE0AE" Text="{DynamicResource tweaks.badge.on}"/>
              </Border>
              <Border Style="{StaticResource Badge}" Background="#20252F" Visibility="{Binding NeedsExplorer, Converter={StaticResource BoolVis}}">
                <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource TextMuted}" Text="{DynamicResource tweaks.badge.explorer}"/>
              </Border>
              <Border Style="{StaticResource Badge}" Background="#1A1E27" Visibility="{Binding ShowUnavailable, Converter={StaticResource BoolVis}}">
                <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource TextDim}" Text="{Binding UnavailableText}"/>
              </Border>
            </WrapPanel>
            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,5,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Row" Property="Background" Value="#181C26"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
          <Setter TargetName="Row" Property="Opacity" Value="0.55"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="GroupCard">
      <Border Style="{StaticResource Card}" Padding="18,18,18,10" Margin="0,0,14,14">
        <StackPanel>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" VerticalAlignment="Top"><TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>
              <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TweakRow}" Margin="-14,0,-10,0"/>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,4,32,30">
      <Grid>
        <StackPanel>
          <TextBlock Text="{DynamicResource tweaks.title}" Style="{StaticResource H1}"/>
          <TextBlock Text="{DynamicResource tweaks.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left"/>
        </StackPanel>
        <TextBlock x:Name="TxtCount" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0"/>
      </Grid>

      <!-- Aviso: reiniciar el Explorador -->
      <Border x:Name="ExplorerBanner" Style="{StaticResource Card}" Background="{StaticResource WarningSoft}" BorderBrush="#4D3F1A" Padding="18,14" Margin="0,18,0,0" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource Warning}" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <TextBlock Grid.Column="1" Text="{DynamicResource tweaks.explorerNotice}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
          <Button x:Name="BtnExplorer" Grid.Column="2" Style="{StaticResource BtnBase}" Margin="16,0,0,0" Content="{DynamicResource tweaks.restartExplorer}" Click="RestartExplorer_Click"/>
        </Grid>
      </Border>

      <!-- Dos columnas independientes (cada tarjeta mide lo que necesita) -->
      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ItemsControl x:Name="LeftGroups" ItemTemplate="{StaticResource GroupCard}"/>
        <ItemsControl x:Name="RightGroups" Grid.Column="1" ItemTemplate="{StaticResource GroupCard}"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl x:Class="Velox.UI.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,4,32,30">
      <TextBlock Text="{DynamicResource ui.diag.title}" Style="{StaticResource H1}"/>
      <TextBlock Text="{DynamicResource ui.diag.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"/>
      <StackPanel x:Name="Groups" Margin="0,8,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>

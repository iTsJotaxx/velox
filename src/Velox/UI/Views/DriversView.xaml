<UserControl x:Class="Velox.UI.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="SafetyChip" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,4,32,30">
      <Grid>
        <StackPanel>
          <TextBlock Text="{DynamicResource ui.drv.title}" Style="{StaticResource H1}"/>
          <TextBlock Text="{DynamicResource ui.drv.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"/>
        </StackPanel>
        <Button x:Name="BtnSearch" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="20,10" Click="Search_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{DynamicResource ui.drv.search}"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- Garantías -->
      <WrapPanel Margin="0,18,0,0">
        <Border Style="{StaticResource SafetyChip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{DynamicResource ui.drv.safe1}" FontSize="12.5"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SafetyChip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{DynamicResource ui.drv.safe2}" FontSize="12.5"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SafetyChip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{DynamicResource ui.drv.safe3}" FontSize="12.5"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SafetyChip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{DynamicResource ui.drv.safe4}" FontSize="12.5"/>
          </StackPanel>
        </Border>
      </WrapPanel>

      <!-- Actualizaciones -->
      <Border Style="{StaticResource Card}" Margin="0,6,0,0">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentText}" Margin="0,0,10,0"/>
              <TextBlock Text="{DynamicResource ui.drv.updates}" Style="{StaticResource H2}"/>
            </StackPanel>
            <TextBlock x:Name="TxtLastSearch" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock x:Name="TxtUpdatesState" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
          <StackPanel x:Name="PanelWarnings" Margin="0,8,0,0"/>
          <ItemsControl x:Name="UpdatesList" Margin="-8,8,-8,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Row" CornerRadius="10" Padding="14,12" Background="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,16,0" Click="Selection_Click"/>
                    <StackPanel Grid.Column="1">
                      <WrapPanel>
                        <TextBlock Text="{Binding DeviceName}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource Badge}" Background="{StaticResource AccentSoft}">
                          <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource AccentText}" Text="{Binding SourceText}"/>
                        </Border>
                      </WrapPanel>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CurrentVersion}" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="  →  " Foreground="{StaticResource TextDim}"/>
                        <TextBlock Text="{Binding NewVersion}" Foreground="{StaticResource Success}" FontWeight="SemiBold"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                        <TextBlock Text="{Binding NewDateText}" Style="{StaticResource Caption}"/>
                        <TextBlock Text=" · " Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#181C26"/>
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid x:Name="InstallBar" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource ui.drv.installNote}" Style="{StaticResource Caption}" VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left"/>
            <Button x:Name="BtnInstall" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right" Padding="20,10" Click="Install_Click"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Gráficas AMD / Intel -->
      <StackPanel x:Name="PanelVendors"/>

      <!-- Componentes -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE772;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentText}" Margin="0,0,10,0"/>
              <TextBlock Text="{DynamicResource ui.drv.devices}" Style="{StaticResource H2}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <CheckBox x:Name="ChkAll" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="ShowAll_Click"/>
              <TextBlock Text="{DynamicResource ui.drv.showAll}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,16,0"/>
              <Button x:Name="BtnRollback" Style="{StaticResource BtnBase}" Content="{DynamicResource ui.drv.rollback}" Click="Rollback_Click"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="{DynamicResource ui.drv.devicesText}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,8,0,10"/>
          <ListView x:Name="DeviceList" SelectionMode="Single" MaxHeight="420" SelectionChanged="DeviceList_SelectionChanged">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="44">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate><TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource AccentText}" Margin="8,0,0,0"/></DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="330">
                  <GridViewColumn.Header><TextBlock Text="{DynamicResource ui.drv.colDevice}"/></GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding Device.DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="190">
                  <GridViewColumn.Header><TextBlock Text="{DynamicResource ui.drv.colMaker}"/></GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate><TextBlock Text="{Binding Device.Manufacturer}" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="150">
                  <GridViewColumn.Header><TextBlock Text="{DynamicResource ui.drv.colVersion}"/></GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate><TextBlock Text="{Binding Device.DriverVersion}"/></DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="110">
                  <GridViewColumn.Header><TextBlock Text="{DynamicResource ui.drv.colDate}"/></GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate><TextBlock Text="{Binding Device.DateText}" Foreground="{StaticResource TextMuted}"/></DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

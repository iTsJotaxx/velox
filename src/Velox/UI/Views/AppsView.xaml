<UserControl x:Class="Velox.UI.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- Una aplicación del catálogo -->
    <DataTemplate x:Key="AppItem">
      <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Focusable="False"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolVis}}" ToolTip="{Binding Tip}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="24" Height="24" CornerRadius="6" Background="{Binding TileBrush}">
            <TextBlock Text="{Binding Letter}" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="10,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <Border Grid.Column="2" x:Name="Badge" Style="{StaticResource Badge}" Margin="0" Background="{StaticResource SuccessSoft}"
                  Visibility="{Binding ShowBadge, Converter={StaticResource BoolVis}}">
            <TextBlock x:Name="BadgeText" Style="{StaticResource BadgeText}" Foreground="#5EE0AE" Text="{Binding BadgeText}"/>
          </Border>
        </Grid>
      </CheckBox>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding BadgeKind}" Value="busy">
          <Setter TargetName="Badge" Property="Background" Value="{StaticResource AccentSoft}"/>
          <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource AccentText}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="error">
          <Setter TargetName="Badge" Property="Background" Value="{StaticResource DangerSoft}"/>
          <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Danger}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="queued">
          <Setter TargetName="Badge" Property="Background" Value="#20252F"/>
          <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource TextMuted}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Tarjeta de categoría -->
    <DataTemplate x:Key="CategoryCard">
      <Border Style="{StaticResource Card}" Padding="12,14,12,10" Margin="0,0,14,14"
              Visibility="{Binding HasVisible, Converter={StaticResource BoolVis}}">
        <StackPanel>
          <Grid Margin="6,0,4,6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource AccentText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="15"/>
            </StackPanel>
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource AppItem}"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Resultado de búsqueda (añadir aplicación) -->
    <DataTemplate x:Key="SearchHit">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding Id, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Version, Mode=OneWay}"/>
          </TextBlock>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource BtnBase}" Padding="12,6" Content="{DynamicResource apps.add.button}" Click="AddHit_Click" Margin="10,0,0,0"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid Margin="32,4,32,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid>
        <StackPanel>
          <TextBlock Text="{DynamicResource apps.title}" Style="{StaticResource H1}"/>
          <TextBlock Text="{DynamicResource apps.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"/>
        </StackPanel>
        <TextBlock x:Name="TxtInstalledState" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0"/>
      </Grid>

      <!-- Barra de acciones -->
      <Grid Grid.Row="1" Margin="0,18,0,0">
        <StackPanel Orientation="Horizontal">
          <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="10" Width="230" Padding="12,0">
            <Grid>
              <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
              <TextBlock x:Name="SearchHint" Text="{DynamicResource apps.filter}" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>
              <TextBox x:Name="TxtFilter" VerticalAlignment="Center" Margin="22,0,0,0" Padding="0,8" TextChanged="Filter_Changed"/>
            </Grid>
          </Border>
          <Button Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Content="{DynamicResource apps.selectInstalled}" Click="SelectInstalled_Click" ToolTip="{DynamicResource apps.selectInstalledTip}"/>
          <Button Style="{StaticResource BtnGhost}" Content="{DynamicResource apps.clear}" Click="Clear_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

          <Button x:Name="BtnAdd" Style="{StaticResource BtnBase}" Margin="0,0,8,0" Click="OpenAdd_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="{DynamicResource apps.addApp}"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnInstall" Style="{StaticResource BtnPrimary}" Padding="20,10" Click="Install_Click"/>
        </StackPanel>
      </Grid>

      <!-- Avisos y progreso -->
      <StackPanel Grid.Row="2">
        <Border x:Name="NoWingetBanner" Style="{StaticResource Card}" Background="{StaticResource WarningSoft}" BorderBrush="#4D3F1A" Padding="18,14" Margin="0,14,0,0" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource Warning}" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <TextBlock Grid.Column="1" Text="{DynamicResource apps.noWinget}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Style="{StaticResource BtnBase}" Margin="16,0,0,0" Content="{DynamicResource apps.getWinget}" Click="GetWinget_Click"/>
          </Grid>
        </Border>
        <Border x:Name="ProgressCard" Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="TxtProgressTitle" FontWeight="SemiBold" FontSize="14"/>
              <ProgressBar x:Name="ProgressAll" Height="5" Margin="0,10,0,6"/>
              <TextBlock x:Name="TxtProgressDetail" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button x:Name="BtnStop" Grid.Column="1" Style="{StaticResource BtnBase}" Margin="18,0,0,0" VerticalAlignment="Center" Content="{DynamicResource apps.stop}" Click="Stop_Click"/>
          </Grid>
        </Border>
      </StackPanel>

      <!-- Catálogo en tres columnas -->
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Padding="0,0,4,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ItemsControl x:Name="Col0" ItemTemplate="{StaticResource CategoryCard}"/>
          <ItemsControl x:Name="Col1" Grid.Column="1" ItemTemplate="{StaticResource CategoryCard}"/>
          <ItemsControl x:Name="Col2" Grid.Column="2" ItemTemplate="{StaticResource CategoryCard}"/>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Elegir región (Riot Client) -->
    <Grid x:Name="RegionLayer" Background="#B8060810" Visibility="Collapsed" Panel.ZIndex="11">
      <Border Style="{StaticResource Card}" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24,22">
        <StackPanel>
          <TextBlock x:Name="TxtRegionTitle" Style="{StaticResource H2}" FontSize="18"/>
          <TextBlock Text="{DynamicResource apps.region.text}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,8,0,14"/>
          <ItemsControl x:Name="RegionList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton GroupName="Region" Margin="0,0,8,6" Cursor="Hand" IsChecked="{Binding IsSelected, Mode=TwoWay}" FocusVisualStyle="{x:Null}">
                  <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                      <Border x:Name="Bd" Background="{StaticResource CardInner}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="9" Padding="12,9">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock x:Name="Mark" Grid.Column="1" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource AccentText}" Margin="8,0,0,0" Visibility="Hidden"/>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Border}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                          <Setter TargetName="Bd" Property="Background" Value="#1A2032"/>
                          <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </RadioButton.Template>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource BtnBase}" Margin="0,0,10,0" Content="{DynamicResource ui.btn.cancel}" Click="RegionCancel_Click"/>
            <Button Style="{StaticResource BtnPrimary}" Content="{DynamicResource apps.region.confirm}" Click="RegionOk_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Añadir aplicación -->
    <Grid x:Name="AddLayer" Background="#B8060810" Visibility="Collapsed" Panel.ZIndex="10">
      <Border Style="{StaticResource Card}" Width="620" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24,22">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="{DynamicResource apps.add.title}" Style="{StaticResource H2}" FontSize="18"/>
            <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Right" Padding="8,4" FontFamily="{StaticResource Icons}" Content="&#xE8BB;" Click="CloseAdd_Click"/>
          </Grid>
          <TextBlock Grid.Row="1" Text="{DynamicResource apps.add.text}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,8,0,0"/>
          <Grid Grid.Row="2" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource CardInner}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12,0">
              <TextBox x:Name="TxtSearch" Padding="0,9" KeyDown="Search_KeyDown"/>
            </Border>
            <Button x:Name="BtnSearch" Grid.Column="1" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Content="{DynamicResource apps.add.search}" Click="Search_Click"/>
          </Grid>
          <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="TxtSearchState" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                <ItemsControl x:Name="Hits" ItemTemplate="{StaticResource SearchHit}"/>
                <TextBlock x:Name="TxtMineTitle" Text="{DynamicResource apps.add.mine}" Style="{StaticResource H2}" FontSize="14" Margin="0,16,0,6"/>
                <ItemsControl x:Name="MineList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Id, Mode=OneWay}" Foreground="{StaticResource TextDim}"/>
                        </TextBlock>
                        <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Padding="10,4" Content="{DynamicResource apps.add.remove}" Click="RemoveMine_Click"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="TxtMineEmpty" Text="{DynamicResource apps.add.mineEmpty}" Style="{StaticResource Caption}"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Button Grid.Row="4" Style="{StaticResource BtnBase}" HorizontalAlignment="Right" Margin="0,14,0,0" Content="{DynamicResource apps.add.done}" Click="CloseAdd_Click"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

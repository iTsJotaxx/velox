<UserControl x:Class="Velox.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,4,32,30" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="{DynamicResource ui.set.title}" Style="{StaticResource H1}"/>
      <TextBlock Text="{DynamicResource ui.set.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>

      <!-- Idioma -->
      <Border Style="{StaticResource Card}" Margin="0,22,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xF2B7;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource ui.set.language}" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource ui.set.languageText}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,3,0,0"/>
          </StackPanel>
          <Border Grid.Column="2" Background="{StaticResource CardInner}" CornerRadius="10" Padding="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="RbEs" Style="{StaticResource Segment}" GroupName="Lang" Content="Español" Click="Lang_Click" Tag="es"/>
              <RadioButton x:Name="RbEn" Style="{StaticResource Segment}" GroupName="Lang" Content="English" Click="Lang_Click" Tag="en"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Preferencias -->
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE81C;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource ui.set.restorePoint}" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource ui.set.restorePointText}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,3,0,0"/>
            </StackPanel>
            <CheckBox x:Name="ChkRestore" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Prefs_Click"/>
          </Grid>
          <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,16"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE8C4;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource ui.set.expand}" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource ui.set.expandText}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,3,0,0"/>
            </StackPanel>
            <CheckBox x:Name="ChkExpand" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Prefs_Click"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Datos -->
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource ui.set.data}" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtDataPath" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource BtnBase}" Content="{DynamicResource ui.set.openFolder}" VerticalAlignment="Center" Click="OpenData_Click"/>
        </Grid>
      </Border>

      <!-- Acerca de -->
      <Border Margin="0,14,0,0" CornerRadius="14" Background="{StaticResource HeroGradient}" BorderBrush="#2A3150" BorderThickness="1" Padding="24,22">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="56" Height="56" CornerRadius="15" Background="{StaticResource AccentGradient}">
            <Viewbox Width="56" Height="56">
              <Canvas Width="36" Height="36">
                <Line X1="4.5" Y1="14.5" X2="9.5" Y2="14.5" Stroke="#99FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line X1="6" Y1="18.7" X2="11" Y2="18.7" Stroke="#99FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Fill="White" Data="M7.2,8.6 L13.7,8.6 L18.7,21.6 L23.8,8.6 L29.5,8.6 L21.6,28.1 L15.8,28.1 Z"/>
              </Canvas>
            </Viewbox>
          </Border>
          <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
            <TextBlock x:Name="TxtAbout" FontFamily="{StaticResource FontDisplay}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource ui.set.aboutText}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0"/>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource BtnBase}" VerticalAlignment="Center" Click="GitHub_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="GitHub"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

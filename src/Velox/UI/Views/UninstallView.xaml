<UserControl x:Class="Velox.UI.Views.UninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <DataTemplate x:Key="ProgramRow">
      <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Focusable="False"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolVis}}" Margin="0,1" ToolTip="{Binding Tip}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="90"/>
          </Grid.ColumnDefinitions>
          <Grid Width="30" Height="30">
            <Border CornerRadius="7" Background="{Binding TileBrush}" Visibility="{Binding NoIcon, Converter={StaticResource BoolVis}}">
              <TextBlock Text="{Binding Letter}" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Grid>
          <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Sub}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Style="{StaticResource Badge}" Background="{StaticResource WarningSoft}" Visibility="{Binding IsProtected, Converter={StaticResource BoolVis}}" ToolTip="{Binding ProtectReason}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="{StaticResource Warning}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource Warning}" Text="{DynamicResource unin.badge.protected}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Badge}" Background="#20252F" Visibility="{Binding IsQuiet, Converter={StaticResource BoolVis}}" ToolTip="{DynamicResource unin.badge.quietTip}">
              <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource TextMuted}" Text="{DynamicResource unin.badge.quiet}"/>
            </Border>
            <Border x:Name="Status" Style="{StaticResource Badge}" Background="{StaticResource AccentSoft}" Visibility="{Binding ShowStatus, Converter={StaticResource BoolVis}}">
              <TextBlock x:Name="StatusText" Style="{StaticResource BadgeText}" Foreground="{StaticResource AccentText}" Text="{Binding Status}"/>
            </Border>
          </StackPanel>
          <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="4" Text="{Binding DateText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
        </Grid>
      </CheckBox>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="ok">
          <Setter TargetName="Status" Property="Background" Value="{StaticResource SuccessSoft}"/>
          <Setter TargetName="StatusText" Property="Foreground" Value="#5EE0AE"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="error">
          <Setter TargetName="Status" Property="Background" Value="{StaticResource DangerSoft}"/>
          <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Danger}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="queued">
          <Setter TargetName="Status" Property="Background" Value="#20252F"/>
          <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource TextMuted}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="32,4,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid>
      <StackPanel>
        <TextBlock Text="{DynamicResource unin.title}" Style="{StaticResource H1}"/>
        <TextBlock Text="{DynamicResource unin.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"/>
      </StackPanel>
      <TextBlock x:Name="TxtTotal" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0"/>
    </Grid>

    <!-- Barra -->
    <Grid Grid.Row="1" Margin="0,18,0,0">
      <StackPanel Orientation="Horizontal">
        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="10" Width="220" Padding="12,0">
          <Grid>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
            <TextBlock x:Name="SearchHint" Text="{DynamicResource unin.filter}" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>
            <TextBox x:Name="TxtFilter" VerticalAlignment="Center" Margin="22,0,0,0" Padding="0,8" TextChanged="Filter_Changed"/>
          </Grid>
        </Border>
        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="10" Padding="3" Margin="10,0,0,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="RbDesktop" Style="{StaticResource Segment}" GroupName="Kind" IsChecked="True" Content="{DynamicResource unin.kind.desktop}" Click="Kind_Click"/>
            <RadioButton x:Name="RbStore" Style="{StaticResource Segment}" GroupName="Kind" Content="{DynamicResource unin.kind.store}" Click="Kind_Click"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="10" Padding="3" Margin="10,0,0,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="RbName" Style="{StaticResource Segment}" GroupName="Sort" IsChecked="True" Content="{DynamicResource unin.sort.name}" Click="Sort_Click"/>
            <RadioButton x:Name="RbSize" Style="{StaticResource Segment}" GroupName="Sort" Content="{DynamicResource unin.sort.size}" Click="Sort_Click"/>
            <RadioButton x:Name="RbDate" Style="{StaticResource Segment}" GroupName="Sort" Content="{DynamicResource unin.sort.date}" Click="Sort_Click"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnRefresh" Style="{StaticResource BtnGhost}" Margin="0,0,6,0" FontFamily="{StaticResource Icons}" Content="&#xE72C;" Click="Refresh_Click" ToolTip="{DynamicResource ui.btn.refresh}"/>
        <Button x:Name="BtnUninstall" Style="{StaticResource BtnDanger}" Padding="20,10" Click="Uninstall_Click"/>
      </StackPanel>
    </Grid>

    <!-- Progreso -->
    <Border x:Name="ProgressCard" Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="TxtProgressTitle" FontWeight="SemiBold" FontSize="14"/>
          <ProgressBar x:Name="ProgressAll" Height="5" Margin="0,10,0,6" Foreground="{StaticResource Danger}"/>
          <TextBlock x:Name="TxtProgressDetail" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button x:Name="BtnStop" Grid.Column="1" Style="{StaticResource BtnBase}" Margin="18,0,0,0" VerticalAlignment="Center" Content="{DynamicResource apps.stop}" Click="Stop_Click"/>
      </Grid>
    </Border>

    <!-- Lista -->
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10,8,6,8" Margin="0,14,0,0">
      <Grid>
        <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="List" ItemTemplate="{StaticResource ProgramRow}" VirtualizingStackPanel.IsVirtualizing="True">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="TxtEmpty" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>

<UserControl x:Class="Velox.UI.Views.DiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Velox.UI.Infra"
             Focusable="True">
  <UserControl.Resources>
    <!-- Tarjeta de unidad -->
    <Style x:Key="DriveCard" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Padding="14,10" Width="236">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Bd" Property="Background" Value="#1A2032"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segmento de la ruta -->
    <Style x:Key="Crumb" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="7,4">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#202634"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="9,7"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="32,4,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Cabecera -->
    <Grid>
      <StackPanel>
        <TextBlock Text="{DynamicResource disk.title}" Style="{StaticResource H1}"/>
        <TextBlock Text="{DynamicResource disk.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="BtnRescan" Style="{StaticResource BtnBase}" Margin="0,0,8,0" Click="Rescan_Click" IsEnabled="False">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{DynamicResource disk.rescan}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource BtnPrimary}" Click="Pick_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8DA;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{DynamicResource disk.pick}"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Unidades -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,18,0,0">
      <ItemsControl x:Name="DriveList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource DriveCard}" Tag="{Binding State}" Click="Drive_Click" ToolTip="{DynamicResource disk.driveTip}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTile}" Width="34" Height="34" VerticalAlignment="Top">
                  <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,0,0">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar Value="{Binding UsedPct, Mode=OneWay}" Height="5" Margin="0,6,0,5" Foreground="{Binding BarBrush}"/>
                  <TextBlock Text="{Binding Sub}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Ruta -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,6" Margin="0,14,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BtnBack" Style="{StaticResource IconBtn}" Content="&#xE72B;" Click="Back_Click" IsEnabled="False" ToolTip="{DynamicResource disk.back}"/>
          <Button x:Name="BtnUp" Style="{StaticResource IconBtn}" Content="&#xE74A;" Click="Up_Click" IsEnabled="False" ToolTip="{DynamicResource disk.up}"/>
          <Border Width="1" Background="{StaticResource BorderSoft}" Margin="6,6"/>
        </StackPanel>
        <ScrollViewer x:Name="CrumbScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center" Margin="4,0,0,0">
          <StackPanel x:Name="Crumbs" Orientation="Horizontal"/>
        </ScrollViewer>
        <TextBlock x:Name="TxtTotal" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,8,0"/>
      </Grid>
    </Border>

    <!-- Contenido -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="340"/>
      </Grid.ColumnDefinitions>

      <!-- Mapa -->
      <Border Style="{StaticResource Card}" Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <infra:Treemap x:Name="Map"/>
          <Border Grid.Row="1" Background="{StaticResource CardInner}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle x:Name="HoverSwatch" Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock x:Name="TxtHover" Grid.Column="1" Foreground="{StaticResource TextMuted}" FontSize="12.5" TextTrimming="CharacterEllipsis" Text="{DynamicResource disk.hoverHint}"/>
            </Grid>
          </Border>

          <!-- Sin analizar -->
          <StackPanel x:Name="EmptyPanel" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
            <Border Width="72" Height="72" CornerRadius="20" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center">
              <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource Icons}" FontSize="32" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{DynamicResource disk.emptyTitle}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock Text="{DynamicResource disk.emptyText}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,0"/>
          </StackPanel>

          <!-- Analizando -->
          <Border x:Name="ScanPanel" Grid.RowSpan="2" Background="#E00F1218" CornerRadius="10" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
              <TextBlock x:Name="TxtScanTitle" Style="{StaticResource H2}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <ProgressBar x:Name="ScanBar" Height="5" Margin="0,16,0,12"/>
              <TextBlock x:Name="TxtScanProgress" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
              <Button Style="{StaticResource BtnBase}" HorizontalAlignment="Center" Margin="0,18,0,0" Content="{DynamicResource ui.btn.cancel}" Click="Cancel_Click"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Lateral -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0" Padding="14,16,10,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
            <TextBlock Text="&#xE8CB;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentText}" Margin="0,0,9,0"/>
            <TextBlock Text="{DynamicResource disk.top}" Style="{StaticResource H2}" FontSize="15"/>
          </StackPanel>
          <ListBox x:Name="TopList" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="-6,0,0,0"
                   MouseDoubleClick="TopList_DoubleClick" PreviewMouseRightButtonUp="TopList_RightClick" SelectionChanged="TopList_SelectionChanged">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="0"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ToolTip="{Binding Tip}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="26" Height="26" CornerRadius="7" Background="{Binding Brush}" VerticalAlignment="Top" Margin="0,1,10,0">
                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                    <Grid Margin="0,5,0,0">
                      <Border Height="4" CornerRadius="2" Background="#232937"/>
                      <Border Height="4" CornerRadius="2" Background="{Binding Brush}" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="10,0,0,0" MinWidth="64">
                    <TextBlock Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding PctText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,14,0,8">
            <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentText}" Margin="0,0,9,0"/>
            <TextBlock Text="{DynamicResource disk.byType}" Style="{StaticResource H2}" FontSize="15"/>
          </StackPanel>
          <StackPanel Grid.Row="3" Margin="4,0,6,0">
            <!-- Barra apilada por tipos -->
            <Border CornerRadius="5" Height="10" ClipToBounds="True" Background="#232937" Margin="0,0,0,10">
              <StackPanel x:Name="KindStrip" Orientation="Horizontal"/>
            </Border>
            <ItemsControl x:Name="KindList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding PctText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

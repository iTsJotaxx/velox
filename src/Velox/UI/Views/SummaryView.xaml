<UserControl x:Class="Velox.UI.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Velox.UI.Infra">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,4,32,30">
      <Grid>
        <StackPanel>
          <TextBlock Text="{DynamicResource ui.sum.title}" Style="{StaticResource H1}"/>
          <TextBlock x:Name="TxtScanTime" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
        </StackPanel>
        <Button x:Name="BtnScan" Style="{StaticResource BtnBase}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Scan_Click" Padding="14,8">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{DynamicResource ui.sum.rescan}"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- Avisos: ajustes que han vuelto a su valor base y comprobación tras reiniciar -->
      <StackPanel x:Name="PanelNotices" Margin="0,18,0,0" Visibility="Collapsed"/>

      <!-- Hoja de reglajes: el equipo (cabecera) y los cambios (tabla) -->
      <Border Margin="0,22,0,0" Style="{StaticResource Card}" Padding="0">
        <StackPanel>
          <!-- Cabecera: el equipo en cifras -->
          <UniformGrid x:Name="SpecTiles" Columns="4" Margin="24,20,24,18"/>
          <Border Height="1" Background="{StaticResource Rule}"/>

          <StackPanel Margin="24,20,24,0">
            <TextBlock x:Name="TxtHeroTitle" Style="{StaticResource H2}" FontSize="22"/>
            <TextBlock x:Name="TxtHeroText" Style="{StaticResource Muted}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
          </StackPanel>

          <!-- Tabla: AJUSTE | AHORA → RECOMENDADO -->
          <Grid x:Name="SheetHead" Margin="24,18,24,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5*"/>
              <ColumnDefinition Width="4*"/>
              <ColumnDefinition Width="36"/>
              <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ColSetting" Style="{StaticResource Label}"/>
            <TextBlock x:Name="ColFrom" Grid.Column="1" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
            <TextBlock x:Name="ColTo" Grid.Column="3" Style="{StaticResource Label}"/>
          </Grid>
          <StackPanel x:Name="SheetRows" Margin="24,8,24,0"/>
          <Button x:Name="BtnMore" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="14,4,0,0" Click="SeeAll_Click" Visibility="Collapsed"/>

          <!-- Pie: aplicar · copias guardadas · volver a la base -->
          <Border Height="1" Background="{StaticResource Rule}" Margin="0,16,0,0"/>
          <Grid Margin="24,16,24,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnApplyRec" Style="{StaticResource BtnPrimary}" Padding="22,11" FontSize="13.5" Click="ApplyRec_Click"/>
              <Button Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Click="SeeAll_Click" Content="{DynamicResource ui.sum.customize}"/>
              <Border x:Name="RestartBadge" Style="{StaticResource Badge}" Margin="12,0,0,0" Background="{StaticResource WarningSoft}" Visibility="Collapsed">
                <TextBlock x:Name="TxtRestartBadge" Style="{StaticResource BadgeText}" Foreground="{StaticResource Warning}"/>
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="TxtSaved" Style="{StaticResource Figure}" FontWeight="Normal" FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
              <Button Style="{StaticResource BtnGhost}" Margin="10,0,0,0" Click="History_Click" Content="{DynamicResource hist.open}"/>
              <Button x:Name="BtnBackToBase" Style="{StaticResource BtnBase}" Margin="14,0,0,0" Padding="14,8" Click="BackToBase_Click" Content="{DynamicResource ui.sum.backToBase}"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Top">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentText}" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource ui.sum.findings}" Style="{StaticResource H2}"/>
              </StackPanel>
              <StackPanel x:Name="PanelFindings"/>
            </StackPanel>
          </Border>
          <!-- Accesos rápidos a lo que más se usa -->
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentText}" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource ui.sum.quick}" Style="{StaticResource H2}"/>
              </StackPanel>
              <UniformGrid Columns="2" Margin="-5">
                <UniformGrid.Resources>
                  <Style TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="Button">
                          <Grid>
                          <Border x:Name="Bd" Background="{StaticResource CardInner}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="13,11">
                            <DockPanel>
                              <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center" Foreground="{StaticResource AccentText}"/>
                              </Border>
                              <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                              <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                          </Border>
                          <Border x:Name="Focus" BorderBrush="{StaticResource FocusRing}" BorderThickness="2" CornerRadius="10" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
                          </Grid>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Selected}"/>
                              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Border}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </UniformGrid.Resources>
                <Button Tag="&#xEEA0;" Click="Quick_Click" CommandParameter="memory">
                  <StackPanel><TextBlock Text="{DynamicResource ui.sum.qMem}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ui.sum.qMemSub}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                </Button>
                <Button Tag="&#xE74D;" Click="Quick_Click" CommandParameter="tools">
                  <StackPanel><TextBlock Text="{DynamicResource ui.sum.qTemp}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ui.sum.qTempSub}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                </Button>
                <Button Tag="&#xE772;" Click="Quick_Click" CommandParameter="drivers">
                  <StackPanel><TextBlock Text="{DynamicResource ui.sum.qDrv}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ui.sum.qDrvSub}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                </Button>
                <Button Tag="&#xEDA2;" Click="Quick_Click" CommandParameter="disk">
                  <StackPanel><TextBlock Text="{DynamicResource ui.sum.qDisk}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ui.sum.qDiskSub}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                </Button>
                <Button Tag="&#xE896;" Click="Quick_Click" CommandParameter="apps">
                  <StackPanel><TextBlock Text="{DynamicResource ui.sum.qApps}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ui.sum.qAppsSub}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                </Button>
                <Button Tag="&#xE7FC;" Click="Quick_Click" CommandParameter="processes">
                  <StackPanel><TextBlock Text="{DynamicResource ui.sum.qGame}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ui.sum.qGameSub}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                </Button>
              </UniformGrid>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentText}" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource ui.sum.system}" Style="{StaticResource H2}"/>
              </StackPanel>
              <StackPanel x:Name="PanelSystem"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentText}" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource ui.sum.topApps}" Style="{StaticResource H2}"/>
              </StackPanel>
              <StackPanel x:Name="PanelTopApps"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl x:Class="Velox.UI.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="32,4,32,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{DynamicResource ui.proc.title}" Style="{StaticResource H1}"/>
      <TextBlock x:Name="TxtSummary" Style="{StaticResource Muted}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,20,0,14">
      <Button Style="{StaticResource BtnBase}" Margin="0,0,8,6" Click="Refresh_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{DynamicResource ui.btn.refresh}"/>
        </StackPanel>
      </Button>
      <Button x:Name="BtnHigh" Style="{StaticResource BtnBase}" Margin="0,0,8,6" Content="{DynamicResource ui.proc.high}" Click="High_Click"/>
      <Button x:Name="BtnNormal" Style="{StaticResource BtnBase}" Margin="0,0,8,6" Content="{DynamicResource ui.proc.normal}" Click="Normal_Click"/>
      <Button x:Name="BtnGame" Style="{StaticResource BtnPrimary}" Margin="0,0,8,6" Click="Game_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{DynamicResource ui.proc.game}"/>
        </StackPanel>
      </Button>
      <Button x:Name="BtnKill" Style="{StaticResource BtnDanger}" Margin="0,0,8,6" Content="{DynamicResource ui.proc.kill}" Click="Kill_Click"/>
    </WrapPanel>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,4">
      <ListView x:Name="List" SelectionMode="Single" SelectionChanged="List_SelectionChanged">
        <ListView.View>
          <GridView>
            <GridViewColumn Width="210">
              <GridViewColumn.Header><TextBlock Text="{DynamicResource ui.proc.colName}"/></GridViewColumn.Header>
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0,8,0"
                               Visibility="{Binding IsProtected, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="70">
              <GridViewColumn.Header><TextBlock Text="{DynamicResource ui.proc.colCount}"/></GridViewColumn.Header>
              <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Count}" Foreground="{StaticResource TextMuted}"/></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="100">
              <GridViewColumn.Header><TextBlock Text="RAM"/></GridViewColumn.Header>
              <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RamText}"/></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="80">
              <GridViewColumn.Header><TextBlock Text="CPU"/></GridViewColumn.Header>
              <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CpuText}"/></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="140">
              <GridViewColumn.Header><TextBlock Text="{DynamicResource ui.proc.colPriority}"/></GridViewColumn.Header>
              <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Priority}" Foreground="{StaticResource TextMuted}"/></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="380">
              <GridViewColumn.Header><TextBlock Text="{DynamicResource ui.proc.colDesc}"/></GridViewColumn.Header>
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Description}" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>
    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentText}" Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource ui.proc.gamesTitle}" Style="{StaticResource H2}"/>
          </StackPanel>
          <TextBlock x:Name="TxtNoGames" Text="{DynamicResource ui.proc.noGames}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
          <ListBox x:Name="Games" MaxHeight="120" Margin="-12,8,0,0">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </StackPanel>
        <Button x:Name="BtnRemoveGame" Grid.Column="1" Style="{StaticResource BtnBase}" VerticalAlignment="Bottom" Content="{DynamicResource ui.proc.removeGame}" Click="RemoveGame_Click"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>

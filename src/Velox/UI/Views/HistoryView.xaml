<UserControl x:Class="Velox.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="32,4,32,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid>
      <StackPanel>
        <TextBlock Text="{DynamicResource hist.title}" Style="{StaticResource H1}"/>
        <TextBlock Text="{DynamicResource hist.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left"/>
      </StackPanel>
      <Button Style="{StaticResource BtnBase}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Back_Click" Content="{DynamicResource hist.back}"/>
    </Grid>

    <!-- Hoja de cambios: FECHA | AJUSTE | ANTES → DESPUÉS | ORIGEN | (deshacer) -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,22,0,0" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="Head" Margin="24,18,24,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="128"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="110"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource hist.colWhen}" Style="{StaticResource Label}"/>
          <TextBlock Grid.Column="1" Text="{DynamicResource hist.colSetting}" Style="{StaticResource Label}"/>
          <TextBlock Grid.Column="2" Text="{DynamicResource hist.colChange}" Style="{StaticResource Label}"/>
          <TextBlock Grid.Column="3" Text="{DynamicResource hist.colSource}" Style="{StaticResource Label}"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="Rows" Margin="24,0,24,16"/>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
